# === TELEGRAM BOT SOZLAMALARI ===

# Bot Token - @BotFather dan oling
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Admin Telegram user ID'lari (vergul bilan ajratilgan)
# O'z ID'ingizni @userinfobot dan bilishingiz mumkin
ADMIN_IDS=123456789

# Majburiy obuna kanallari (vergul bilan ajratilgan)
# Bo'sh qoldirsa, majburiy obuna o'chiq bo'ladi
FORCE_SUB_CHANNELS=@your_channel1,@your_channel2

# Post qilinadigan kanal (animelarni shu kanalga post qiladi)
# Bot shu kanalga admin sifatida qo'shilgan bo'lishi kerak
POST_CHANNEL=@your_anime_channel
